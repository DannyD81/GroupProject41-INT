<?php
session_start();
$db = new SQLite3('MortgageSystem.db');
if (!$db) {
    die("Database connection failed.");
}

if (!isset($_SESSION['UserID'])) {
    header("Location: login-page.php");
    exit();
}

$user_id = $_SESSION['UserID'];

// Get user's saved quotes for dropdowns
$quotes_result = $db->query("SELECT QuoteID, Purchaseprice, DepositAmount FROM UserQuotes WHERE UserID = $user_id");

$quotes = [];
while ($row = $quotes_result->fetchArray(SQLITE3_ASSOC)) {
    $quotes[] = $row;
}

// Handle POST submission
if ($_SERVER["REQUEST_METHOD"] === "POST") {
    $quote1 = $_POST['quote1'] ?? null;
    $quote2 = $_POST['quote2'] ?? null;
    $quote3 = $_POST['quote3'] ?? null;

    // Ensure at least two quotes are selected and all selected values are distinct
    $selectedQuotes = array_filter([$quote1, $quote2, $quote3]);
    $uniqueQuotes = array_unique($selectedQuotes);

    if (count($uniqueQuotes) < 2) {
        echo "<div class='alert alert-warning text-center'>Please select at least 2 different quotes to compare.</div>";
    } else {
        $stmt = $db->prepare("INSERT INTO SavedComparisons (UserID, Quote1ID, Quote2ID, Quote3ID, DateSaved) VALUES (:user_id, :q1, :q2, :q3, :date_saved)");
        $stmt->bindValue(':user_id', $user_id, SQLITE3_INTEGER);
        $stmt->bindValue(':q1', $quote1 ?: null, SQLITE3_INTEGER);
        $stmt->bindValue(':q2', $quote2 ?: null, SQLITE3_INTEGER);
        $stmt->bindValue(':q3', $quote3 ?: null, SQLITE3_INTEGER);
        $stmt->bindValue(':date_saved', date('Y-m-d H:i:s'), SQLITE3_TEXT);

        if ($stmt->execute()) {
            echo "<div class='alert alert-success text-center'>Comparison saved successfully!</div>";
        } else {
            echo "<div class='alert alert-danger text-center'>Failed to save comparison. Try again.</div>";
        }
    }
}
